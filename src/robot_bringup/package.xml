<?xml version="1.0"?>
<package format="2">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>两轮差速机器人实物包: 雷达驱动 / 里程计 / EKF 融合 / SLAM / 导航 / 人体跟随</description>
  <maintainer email="lawliet206@163.com">lawliet</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/lawliet206/ROS</url>
  <url type="bugtracker">https://github.com/lawliet206/ROS/issues</url>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- 运行时依赖 -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rosserial_python</exec_depend>
  <exec_depend>gmapping</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
  </export>
</package>
