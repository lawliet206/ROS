Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.8
      Class: rviz/Map
      Enabled: true
      Name: Map
      Topic: /map
      Value: true
    - Class: rviz/LaserScan
      Color: 255; 255; 255
      Decay Time: 0
      Enabled: true
      Name: Laser Scan
      Position Transformer: XYZ
      Queue Size: 10
      Size (Pixels): 3
      Style: Points
      Topic: /scan
      Value: true
    - Class: rviz/RobotModel
      Enabled: true
      Name: Robot
      Robot Description: robot_description
      TF Prefix: ""
      Value: true
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: Top View
      Near Clip Distance: 0.01
      Scale: 40
      Target Frame: map
      X: 0
      Y: 0
      Yaw: 0
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  X: 40
  Y: 40
