<?xml version="1.0"?>
<package format="2">
  <name>robot_sim</name>
  <version>0.1.0</version>
  <description>Gazebo 仿真包: 两轮差速机器人仿真环境 (SLAM + 导航 + 跟随)</description>
  <maintainer email="lawliet206@163.com">lawliet</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/lawliet206/ROS</url>
  <url type="bugtracker">https://github.com/lawliet206/ROS/issues</url>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- sim_follow.sh / sim_navigation.sh 通过 rosrun robot_bringup 调用 send_goals / laser_follower -->
  <exec_depend>robot_bringup</exec_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>gmapping</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
  </export>
</package>
