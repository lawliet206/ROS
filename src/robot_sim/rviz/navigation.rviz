Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz/Map
      Enabled: true
      Name: 地图
      Topic: /map
      Value: true
    - Class: rviz/RobotModel
      Enabled: true
      Name: 机器人模型
      Visual Enabled: true
      Links:
        All Links Enabled: true
        Expand Link Details: false
        Expand Tree: false
      Robot Description: robot_description
      Value: true
    - Alpha: 1
      Class: rviz/LaserScan
      Color: 255 255 255
      Decay Time: 0
      Enabled: true
      Name: 激光雷达
      Topic: /scan
      Size (m): 0.03
      Style: Flat Squares
      Value: true
    - Class: rviz/Path
      Color: 0 255 0
      Enabled: true
      Name: 全局路径
      Topic: /move_base/NavfnROS/plan
      Value: true
      Alpha: 1
      Width: 0.05
    - Class: rviz/Path
      Color: 255 0 0
      Enabled: true
      Name: TEB局部路径
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Value: true
      Alpha: 1
      Width: 0.08
    - Alpha: 0.4
      Class: rviz/PoseArray
      Color: 255 255 0
      Enabled: true
      Name: AMCL粒子
      Topic: /amcl/particles
      Value: true
    - Alpha: 0.25
      Class: rviz/Map
      Color: 0 255 0
      Enabled: true
      Name: 全局代价地图
      Topic: /move_base/global_costmap/costmap
      Value: true
    - Alpha: 0.25
      Class: rviz/Map
      Color: 0 0 255
      Enabled: true
      Name: 局部代价地图
      Topic: /move_base/local_costmap/costmap
      Value: true
    - Class: rviz/Polygon
      Alpha: 0.6
      Color: 255 255 255
      Enabled: true
      Name: 机器人足迹
      Topic: /move_base/local_costmap/footprint
      Value: true
    - Alpha: 0.8
      Class: rviz/TF
      Enabled: true
      Name: TF坐标
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
      Frame Timeout: 15
      Marker Scale: 1
      Update Interval: 0
      Frames:
        All Enabled: true
    - Class: rviz/PoseWithCovariance
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255 255 127
          Color Style: Unique
          Enabled: true
          Offset: 0
          Scale: 0.5
          Value: true
        Position:
          Alpha: 0.3
          Color: 204 51 204
          Enabled: true
          Offset: 0
          Scale: 1
          Value: true
      Enabled: true
      Name: AMCL位姿协方差
      Topic: /amcl_pose
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48 48 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz/XYOrbit
      Distance: 12
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.5707963705062866
      Target Frame: <Fixed Frame>
      Value: XYOrbit (rviz)
      Yaw: 3.1415927410125732
    Saved: ~
